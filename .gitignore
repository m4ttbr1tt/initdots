# Ignore everything by default
*

# Allow repository metadata files
!.gitignore
!README.md

# Allow bootstrap scripts
!decrypt-age-to-ssh.sh
!encrypt-with-age.sh

# Allow encrypted bootstrap files
!config.age
!id_ed25519.age
!id_ed25519.pub.age

# Allow archinstall files we intentionally commit
!archinstall/
!archinstall/install.sh
!archinstall/user_configuration.json
!archinstall/user_credentials.example.json

# Keep generated/sensitive archinstall credentials ignored
archinstall/user_credentials.json
